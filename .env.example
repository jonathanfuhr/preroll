# Datenbank
DATABASE_URL="postgresql://preroll:preroll@postgres:5432/preroll?schema=public"

# Signiert die Session-Cookies. In Produktion zwingend ändern:
#   openssl rand -base64 32
SESSION_SECRET="bitte-aendern"

# Öffentliche Basis-URL. Steckt in Mails, Freigabe-Links und Web-Push — und
# entscheidet über das secure-Flag der Cookies. Hinter dem Cloudflare-Tunnel
# muss hier die https-Adresse stehen, nicht localhost.
APP_URL="https://preroll.fuhrzwei.de"

# Host-Port, auf dem der Cloudflare-Tunnel die App findet. 4400, weil auf dem
# Mac Mini schon Klappe (3000) und Mappe (4300) liegen.
PORT=4400

# Nur die Loopback-Adresse veröffentlichen — der Tunnel läuft auf demselben
# Rechner. Auf 0.0.0.0 setzen, wenn die App auch aus dem LAN erreichbar sein
# soll.
BIND_ADDR=127.0.0.1

# Wohin die hochgeladenen Medien auf dem Host gehören. Dieser Pfad wird nach
# /app/data in den Container gehängt — die Dateien liegen also auf dem Mac
# bzw. Server und überleben jedes Neubauen des Images.
#   MEDIEN_PFAD="/Volumes/Produktion/preroll"
#   MEDIEN_PFAD="/volume1/preroll/medien"
MEDIEN_PFAD="./data"

# Verzeichnis innerhalb des Containers — zeigt auf den Bind-Mount oben und
# muss normalerweise nicht angefasst werden.
UPLOAD_DIR="/app/data/uploads"

# Startpasswort für die Beispieldaten (nur beim Seed relevant).
SEED_PASSWORT="preroll"

# ---------------------------------------------------------------------------
# Mailversand, Microsoft-Anmeldung und die Klappe-Anbindung werden nicht hier,
# sondern in der Oberfläche unter Einstellungen hinterlegt. Sie liegen in der
# Datenbank, damit sie ohne Neustart des Containers änderbar sind.
# ---------------------------------------------------------------------------
