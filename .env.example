# Datenbank
DATABASE_URL="postgresql://preroll:preroll@postgres:5432/preroll?schema=public"

# Signiert die Session-Cookies. In Produktion zwingend ändern:
#   openssl rand -base64 32
SESSION_SECRET="bitte-aendern"

# Öffentliche Basis-URL. Steckt in Mails, Freigabe-Links und Web-Push.
APP_URL="https://preroll.fuhrzwei.de"

# Verzeichnis für hochgeladene Medien (im Container ein Volume).
UPLOAD_DIR="/app/data/uploads"

# Startpasswort für die Beispieldaten (nur beim Seed relevant).
SEED_PASSWORT="preroll"

# ---------------------------------------------------------------------------
# Mailversand, Microsoft-Anmeldung und die Klappe-Anbindung werden nicht hier,
# sondern in der Oberfläche unter Einstellungen hinterlegt. Sie liegen in der
# Datenbank, damit sie ohne Neustart des Containers änderbar sind.
# ---------------------------------------------------------------------------
