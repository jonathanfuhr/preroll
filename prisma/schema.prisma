// Preroll — Planung und Kundenfreigabe von Social-Media-Konzepten.
// Ein Workspace pro Container (kein Multi-Tenant), analog zu Klappe.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// Die Verbindungs-URL steht seit Prisma 7 in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Team & Auth

/**
 * Alle Rollen dürfen alles lesen und bearbeiten — sie unterscheiden sich in
 * den Rechten der Verwaltung und darin, wer worüber benachrichtigt wird.
 */
enum Rolle {
  /** Zusätzlich Einstellungen und Benutzerverwaltung. */
  ADMIN
  /** Bekommt Benachrichtigungen von allen Kunden. */
  PROJEKTMANAGER
  /** Bekommt Benachrichtigungen der betreuten Kunden und eigener Exporte. */
  DESIGNER
  /** Wie Designer, aber nicht als Ansprechpartner wählbar. */
  EDITOR
}

model Nutzer {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  initialen    String  @db.VarChar(4)
  passwortHash String?
  // Gesetzt, wenn das Konto über Microsoft Entra ID kommt.
  oidcSubjekt  String? @unique
  rolle        Rolle   @default(EDITOR)
  aktiv        Boolean @default(true)

  // Erscheinen im Kontakt-Fuß der Export-Seite, wenn dieses Konto dort als
  // Ansprechpartner steht. Die Agenturanschrift steht in den Einstellungen.
  position String?
  telefon  String?
  fotoId   String?
  foto     Medium? @relation("NutzerFoto", fields: [fotoId], references: [id], onDelete: SetNull)

  mailBenachrichtigungen Boolean @default(true)
  pushBenachrichtigungen Boolean @default(true)

  sessions       NutzerSession[]
  pushAbos       PushAbo[]
  verantwortlich Post[]          @relation("Verantwortlich")
  hochgeladen    Medium[]
  kommentare     Kommentar[]
  einladungen    ExportGast[]    @relation("Einladungen")
  freigaben      Freigabe[]
  benachrichtigungen Benachrichtigung[]
  hauptAnsprechpartnerVon Kunde[]  @relation("Hauptansprechpartner")
  betreut                 KundeBetreuer[]
  favoriten               KundeFavorit[]
  zusatzAnsprechpartnerVon Export[] @relation("ZusatzAnsprechpartner")

  erstelltAm     DateTime  @default(now())
  aktualisiertAm DateTime  @updatedAt
  zuletztAktivAm DateTime?

  @@map("nutzer")
}

/**
 * Angehefteter Kunde — je Nutzer, nicht je Team. Wer drei Kunden betreut,
 * will genau die in der Seitenleiste, nicht alle zwanzig.
 */
model KundeFavorit {
  id       String @id @default(cuid())
  nutzerId String
  nutzer   Nutzer @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
  kundeId  String
  kunde    Kunde  @relation(fields: [kundeId], references: [id], onDelete: Cascade)

  erstelltAm DateTime @default(now())

  @@unique([nutzerId, kundeId])
  @@index([kundeId])
  @@map("kunde_favorit")
}

model NutzerSession {
  id         String   @id @default(cuid())
  nutzerId   String
  nutzer     Nutzer   @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  laeuftAbAm DateTime
  erstelltAm DateTime @default(now())

  @@index([nutzerId])
  @@map("nutzer_session")
}

// Gäste sind Kundenkontakte, die sich passwortlos per Mail-Code anmelden.
model Gast {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  zuletztAktivAm DateTime?
  erstelltAm    DateTime  @default(now())

  mailBenachrichtigungen Boolean @default(true)
  pushBenachrichtigungen Boolean @default(false)

  sessions     GastSession[]
  pushAbos     PushAbo[]
  kommentare   Kommentar[]
  freigaben    Freigabe[]
  beteiligungen ExportGast[]

  @@map("gast")
}

// Verbindet Gast und Export. Entsteht durch Einladung aus dem Backend oder
// beim ersten Anmelden über einen Link — trägt die Gast-Übersicht „meine Freigaben".
model ExportGast {
  id       String @id @default(cuid())
  exportId String
  export   Export @relation(fields: [exportId], references: [id], onDelete: Cascade)
  gastId   String
  gast     Gast   @relation(fields: [gastId], references: [id], onDelete: Cascade)

  eingeladenAm       DateTime  @default(now())
  eingeladenVonId    String?
  eingeladenVon      Nutzer?   @relation("Einladungen", fields: [eingeladenVonId], references: [id], onDelete: SetNull)
  zuletztGeoeffnetAm DateTime?

  @@unique([exportId, gastId])
  @@index([gastId])
  @@map("export_gast")
}

model GastSession {
  id         String   @id @default(cuid())
  gastId     String
  gast       Gast     @relation(fields: [gastId], references: [id], onDelete: Cascade)
  exportId   String?
  export     Export?  @relation(fields: [exportId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  laeuftAbAm DateTime
  erstelltAm DateTime @default(now())

  @@index([gastId])
  @@map("gast_session")
}

// Sechsstelliger Anmeldecode per E-Mail — für Gäste, optional auch fürs Team.
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  exportId   String?
  versuche   Int       @default(0)
  eingelöstAm DateTime?
  laeuftAbAm DateTime
  erstelltAm DateTime  @default(now())

  @@index([email])
  @@map("login_code")
}

// ------------------------------------------------------------------- Stammdaten

model Kunde {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  logoId     String?
  logo       Medium? @relation("KundeLogo", fields: [logoId], references: [id], onDelete: SetNull)
  notiz      String?
  archiviert Boolean @default(false)

  /**
   * Handle, Bio, Website und die Kennzahlen stehen je Plattform in
   * `PlattformProfil` — vorher lagen sie flach hier und meinten
   * stillschweigend Instagram.
   */
  profile PlattformProfil[]

  // Vorbelegung für neue Posts, wenn beim Anlegen kein Termin gesetzt wird.
  standardUhrzeit String @default("10:00")
  /**
   * Bei eigenen Kanälen gibt es niemanden, der freigeben müsste. Dann fällt
   * der Freigabeschritt weg — Posts wandern direkt von Konzept auf Final.
   */
  freigabenNoetig Boolean @default(true)

  /**
   * Darf der Kunde die Dateien selbst herunterladen? Dann steht auf seiner
   * Seite ein Knopf, der die **finalen** Beiträge des Monats als ZIP liefert.
   *
   * Bewusst je Kunde und standardmäßig aus: Wer selbst postet, braucht die
   * Dateien; wer von der Agentur betreut wird, soll sie nicht versehentlich
   * schon im Konzeptstand in der Hand haben. Und bewusst nur Finales — ein
   * Konzept, das noch einmal umgebaut wird, gehört nicht in fremde Ordner.
   */
  zipFuerKunden Boolean @default(false)

  // Verbindet den Kunden mit seinem Projekt in Klappe. Ohne diese Zuordnung
  // zeigt die Videoauswahl nichts an — sonst stünden dort alle Videos aller
  // Kunden, und das wird auf Dauer unübersichtlich.
  klappeProjektId   String?
  klappeProjektName String?
  // Das Gegenstück in awork. Was Preroll damit tut, ist noch offen — die
  // Zuordnung steht schon, damit sie nicht später nachgetragen werden muss.
  aworkProjektId    String?
  aworkProjektName  String?

  /**
   * Veröffentlicht Preroll für diesen Kunden selbst? Aus heißt: Der Plan wird
   * wie bisher von Hand gepostet. Bewusst je Kunde und standardmäßig aus —
   * ein Werkzeug, das ungefragt anfängt zu posten, wäre eine Zumutung.
   */
  postenAktiv Boolean @default(false)

  /**
   * Auf welche Plattformen dieser Kunde bespielt wird. Das ist die **Absicht**
   * und nicht die Möglichkeit: Ob Preroll dorthin auch wirklich posten kann,
   * entscheidet die Zuordnung darunter (`fbSeitenId`, `igKontoId`).
   *
   * Dient als Vorbelegung für neue Beiträge; am einzelnen Beitrag lässt sich
   * davon abweichen. Standard ist das Kreuzposten, weil das der Alltag ist.
   */
  plattformen Plattform[] @default([INSTAGRAM, FACEBOOK])

  /**
   * Über welchen Zugang. Facebook und Instagram teilen sich einen: Das
   * Instagram-Konto hängt an der Facebook-Seite, und der Seiten-Token bedient
   * beide.
   */
  metaZugangId String?
  metaZugang   PlattformZugang? @relation(fields: [metaZugangId], references: [id], onDelete: SetNull)

  /**
   * Aus `me/accounts` geholt. Der Seiten-Token stammt aus demselben Aufruf und
   * läuft nicht ab, solange der Zugang dahinter lebt — deshalb liegt er hier
   * und wird nicht bei jedem Posten neu besorgt.
   */
  fbSeitenId    String?
  fbSeitenName  String?
  fbSeitenToken String?
  igKontoId     String?
  igName        String?

  /**
   * LinkedIn. Getrennt vom Meta-Zugang, weil es ein anderer Anbieter mit
   * anderer Anmeldung ist: Bei Meta gilt ein Systemnutzer-Token, das nicht
   * abläuft; bei LinkedIn ein Mitgliedstoken, das nach 60 Tagen erneuert
   * werden muss.
   *
   * Die Kennung ist die Organisation, nicht die Person — gepostet wird als
   * Firmenseite. `urn:li:organization:<id>` baut der Code daraus zusammen;
   * gespeichert wird nur die Zahl, damit ein Wechsel des URN-Formats keine
   * Migration braucht.
   */
  liZugangId       String?
  liZugang         PlattformZugang? @relation("LinkedInZugang", fields: [liZugangId], references: [id], onDelete: SetNull)
  liOrganisationId String?
  liOrganisation   String?

  // Der Hauptansprechpartner steht auf jeder Export-Seite dieses Kunden und
  // bekommt jede Rückmeldung — auch wenn für einen Export zusätzlich jemand
  // anderes hinterlegt ist.
  hauptAnsprechpartnerId String?
  hauptAnsprechpartner   Nutzer? @relation("Hauptansprechpartner", fields: [hauptAnsprechpartnerId], references: [id], onDelete: SetNull)

  betreuer  KundeBetreuer[]
  favoriten KundeFavorit[]
  posts     Post[]
  medien          Medium[]
  exporte         Export[]
  customFelder    CustomFeldDefinition[]
  kennzahlen      KennzahlVerlauf[]

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@map("kunde")
}

enum KennzahlenQuelle {
  MANUELL
  /** Über die angemeldete Sitzung geholt — siehe `instagram-kennzahlen.ts`. */
  INSTAGRAM_WEB
  /** Der dokumentierte Weg, sobald das Meta App Review durch ist. */
  GRAPH_API
}

/**
 * Das Profil eines Kunden auf **einer** Plattform: öffentlicher Name, Bio,
 * Website und die drei Zahlen.
 *
 * Vorher lagen diese Felder flach am Kunden und meinten stillschweigend
 * Instagram. Das trug nicht mehr, sobald Facebook und LinkedIn dieselben
 * Angaben brauchen: Entweder hätte es `fbFollower`, `liFollower` und so weiter
 * gegeben — dieselbe Sache in drei Sätzen Spalten —, oder die Zahlen eines
 * Kanals hätten für alle gegolten.
 *
 * Instagram bleibt trotzdem besonders: Nur seine Werte holt Preroll selbst
 * (`instagram-kennzahlen.ts`), und nur sie stehen über der Feed-Vorschau — die
 * ist ein Instagram-Profil und wird keines von LinkedIn.
 */
model PlattformProfil {
  id        String    @id @default(cuid())
  kundeId   String
  kunde     Kunde     @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  plattform Plattform

  /**
   * Der öffentliche Name: bei Instagram der Handle ohne @, bei LinkedIn der
   * Teil hinter `/company/`, bei Facebook der Seitenname. Wofür Preroll
   * postet, steht davon getrennt am Kunden — ein Handle ist eine Angabe über
   * das Profil, keine Zuordnung eines Kanals.
   */
  handle  String?
  bio     String?
  website String?

  follower  Int?
  gefolgt   Int?
  beitraege Int?

  standAm DateTime?
  quelle  KennzahlenQuelle @default(MANUELL)

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@unique([kundeId, plattform])
  @@map("plattform_profil")
}

/**
 * Tageswerte der Profil-Kennzahlen — ergibt nebenbei die Follower-Kurve.
 *
 * Je Plattform eine Reihe: Ohne die Spalte hätte ein zweiter Kanal die Kurve
 * des ersten überschrieben, weil die Eindeutigkeit nur auf dem Tag lag.
 */
model KennzahlVerlauf {
  id        String           @id @default(cuid())
  kundeId   String
  kunde     Kunde            @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  plattform Plattform        @default(INSTAGRAM)
  datum     DateTime         @db.Date
  follower  Int?
  gefolgt   Int?
  beitraege Int?
  quelle    KennzahlenQuelle @default(MANUELL)

  @@unique([kundeId, plattform, datum])
  @@map("kennzahl_verlauf")
}

/**
 * Wer einen Kunden betreut. Designer bekommen darüber ihre
 * Benachrichtigungen; Projektmanager hören ohnehin bei allen Kunden mit.
 */
model KundeBetreuer {
  id       String @id @default(cuid())
  kundeId  String
  kunde    Kunde  @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  nutzerId String
  nutzer   Nutzer @relation(fields: [nutzerId], references: [id], onDelete: Cascade)

  erstelltAm DateTime @default(now())

  @@unique([kundeId, nutzerId])
  @@index([nutzerId])
  @@map("kunde_betreuer")
}

// ---------------------------------------------------------------------- Medien

model Medium {
  id        String  @id @default(cuid())
  kundeId   String?
  kunde     Kunde?  @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  dateiname String
  // Pfad relativ zum Upload-Verzeichnis, nie an den Browser durchgereicht.
  pfad      String
  mimeTyp   String
  groesse   Int
  breite    Int
  hoehe     Int
  // Vorschau im Raster; bei 9:16-Medien der mittige 4:5-Ausschnitt.
  thumbPfad String?

  // Gesetzt, wenn dieses Medium beim Auftrennen eines Gesamtbildes entstand.
  quelleId String?
  quelle   Medium?  @relation("Auftrennung", fields: [quelleId], references: [id], onDelete: SetNull)
  abschnitte Medium[] @relation("Auftrennung")

  hochgeladenVonId String?
  hochgeladenVon   Nutzer? @relation(fields: [hochgeladenVonId], references: [id], onDelete: SetNull)

  postMedien       PostMedium[]
  kundeLogo        Kunde[]           @relation("KundeLogo")
  nutzerFoto       Nutzer[]          @relation("NutzerFoto")

  erstelltAm DateTime @default(now())

  @@index([kundeId])
  @@map("medium")
}

// ----------------------------------------------------------------------- Posts

enum PostTyp {
  REEL
  KARUSSELL
  BEITRAG
}

/**
 * Seitenverhältnis eines Beitrags. Steht neben dem Typ, nicht darin: Der Typ
 * sagt, woraus ein Beitrag besteht, das Verhältnis, wie er aussieht. Was je
 * Typ zur Wahl steht, entscheidet `src/lib/verhaeltnis.ts`.
 */
enum Verhaeltnis {
  /**
   * Der Standard für Beiträge und Slides. Instagram nimmt beim Posten nichts
   * Höheres an; das Profilraster zeigt davon einen 3:4-Ausschnitt.
   */
  HOCH_4_5
  /**
   * Bleibt, weil Beiträge damit angelegt wurden, als 3:4 als Standard galt.
   * Für neue ist es die schlechtere Wahl — aber ein Format, das es nicht mehr
   * gibt, ließe den Bestand nicht mehr speichern.
   */
  HOCH_3_4
  QUADRAT_1_1
  VERTIKAL_9_16
  QUER_16_9
}

enum PostStatus {
  /**
   * Vor dem Konzept: in Arbeit, nur intern. Geht in keine Freigabe, taucht
   * in keiner Kundenansicht auf und hat in der Zeitleiste beim Kunden kein
   * Gegenstück — für ihn beginnt der Weg beim Konzept.
   */
  ENTWURF
  KONZEPT
  VORSCHAU
  FINAL
}

model Post {
  id      String     @id @default(cuid())
  kundeId String
  kunde   Kunde      @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  typ     PostTyp
  status  PostStatus @default(KONZEPT)

  // Datum und Uhrzeit der Veröffentlichung — trägt die ZIP-Dateinamen. Leer
  // heißt: noch ungeplant. Solche Posts stehen im Kalender in einer eigenen
  // Spalte und lassen sich von dort auf einen Tag ziehen.
  postenAm DateTime?

  titel            String
  kurzbeschreibung String?
  caption          String  @default("")

  // Freie Eckdaten aus dem Editor.
  laenge String?
  ziel   String?
  stil   String?

  verantwortlichId String?
  verantwortlich   Nutzer? @relation("Verantwortlich", fields: [verantwortlichId], references: [id], onDelete: SetNull)

  verhaeltnis Verhaeltnis @default(HOCH_4_5)

  /**
   * Wohin dieser Beitrag geht. Beim Anlegen aus dem Kunden vorbelegt und
   * danach eigenständig: Wer die Wahl am Kunden ändert, ändert damit nicht
   * rückwirkend jeden Beitrag, der längst geplant ist — das entscheidet in
   * den Stammdaten ein eigener Haken.
   *
   * Leer heißt ausdrücklich „für diesen Beitrag postet Preroll nicht".
   */
  plattformen Plattform[]

  // Reel: Szenenplan ist optional. Ohne ihn tritt das Freitextfeld an seine Stelle.
  szenenplanAktiv Boolean @default(true)
  inhalte         String?

  // Video von einem Link. Das Ergebnis hängt als MEDIUM am Post — derselbe
  // Platz, den auch ein Upload füllt; einen eigenen Referenzvideo-Platz gibt
  // es nicht. Der Download läuft im Hintergrund weiter, auch wenn der Dialog
  // zugeht — deshalb steht sein Stand in der Datenbank und nicht im Speicher.
  videoDownloadUrl         String?
  videoDownloadStand       Ladestand?
  videoDownloadFortschritt Int        @default(0)
  videoDownloadMeldung     String?

  // Finales Reel aus Klappe. Das Video entsteht beim Anlegen des Posts
  // automatisch mit, damit beim Upload kein Name mehr getippt werden muss.
  klappeVideoId       String?
  klappeVideoName     String?
  klappeVideoUrl      String?
  klappeVersionId     String?
  klappeVersionNummer Int?
  klappeStandAm       DateTime?

  szenen       Szene[]
  medien       PostMedium[]
  customWerte  CustomFeldWert[]
  kommentare   Kommentar[]
  freigaben    Freigabe[]
  veroeffentlichungen Veroeffentlichung[]

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([kundeId, postenAm])
  @@map("post")
}

enum MediumRolle {
  MEDIUM // Beitragsbild oder Reel-Video
  SLIDE // Karussell-Slide
  THUMBNAIL // Reel-Thumbnail (9:16)
}

model PostMedium {
  id       String      @id @default(cuid())
  postId   String
  post     Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediumId String
  medium   Medium      @relation(fields: [mediumId], references: [id], onDelete: Cascade)
  rolle    MediumRolle @default(MEDIUM)
  position Int         @default(0)

  @@unique([postId, rolle, position])
  @@index([mediumId])
  @@map("post_medium")
}

/** Wie weit ein Video-Download ist. Leer heißt: keiner gelaufen. */
enum Ladestand {
  LAEUFT
  FERTIG
  FEHLER
}

model Szene {
  id               String  @id @default(cuid())
  postId           String
  post             Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  position         Int
  abschnitt        String  @default("Szene") // Hook, Intro, Szene, Abbinder
  bildSzene        String?
  sprechertext     String?
  texteinblendung  String?

  @@unique([postId, position])
  @@map("szene")
}

enum CustomFeldTyp {
  TEXT
  DATUM
  JANEIN
}

// Eigene Felder werden pro Kunde definiert und je Post befüllt.
model CustomFeldDefinition {
  id       String        @id @default(cuid())
  kundeId  String
  kunde    Kunde         @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  name     String
  typ      CustomFeldTyp @default(TEXT)
  position Int           @default(0)

  werte CustomFeldWert[]

  @@unique([kundeId, name])
  @@map("custom_feld_definition")
}

model CustomFeldWert {
  id           String               @id @default(cuid())
  postId       String
  post         Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  definitionId String
  definition   CustomFeldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  wert         String?

  @@unique([postId, definitionId])
  @@map("custom_feld_wert")
}

// --------------------------------------------------------------------- Export

/**
 * Der Freigabezugang eines Kunden — **genau einer**, kein Link je Monat.
 *
 * Vorher gab es eine Freigabe je Monat, und damit einen Link je Monat: neue
 * Einladung, neue Mail, und ein Gast, der im August eingeladen war, kam im
 * September nicht mehr hinein. Der Monat ist aber keine Eigenschaft des
 * Zugangs, sondern eine Ansicht darin — er steht deshalb in der Adresse
 * (`/f/<token>?monat=2026-08`), und welche Monate es gibt, ergibt sich aus den
 * Beiträgen. Wer den Link einmal hat, sieht jeden Monat, auch die alten.
 *
 * Dass der Kunde damit auch den kommenden Monat sieht, ist gewollt und
 * ungefährlich: Was noch nicht vorzeigbar ist, steht auf `ENTWURF` und
 * erscheint in keiner Kundenansicht.
 */
model Export {
  id      String @id @default(cuid())
  kundeId String @unique
  kunde   Kunde  @relation(fields: [kundeId], references: [id], onDelete: Cascade)

  // Öffentlicher Token im Link /f/<token>.
  token String @unique
  titel String?

  // Zusätzlicher Ansprechpartner nur für diesen Zugang. Er erscheint neben dem
  // Hauptansprechpartner des Kunden und bekommt dessen Rückmeldungen mit —
  // ersetzt ihn also nicht.
  zusatzAnsprechpartnerId String?
  zusatzAnsprechpartner   Nutzer? @relation("ZusatzAnsprechpartner", fields: [zusatzAnsprechpartnerId], references: [id], onDelete: SetNull)

  aufrufe          Int       @default(0)
  zuletztGeoeffnet DateTime?

  kommentare   Kommentar[]
  freigaben    Freigabe[]
  gastSessions GastSession[]
  gaeste       ExportGast[]

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@map("export")
}

/**
 * Der Kunde gibt zweimal frei: einmal das Konzept, nach dem Dreh die Vorschau.
 * Welche Stufe ansteht, ergibt sich aus dem Status des Posts.
 */
enum Freigabestufe {
  KONZEPT
  VORSCHAU
}

model Freigabe {
  id     String        @id @default(cuid())
  postId String
  post   Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  stufe  Freigabestufe

  // Über welchen Link die Freigabe kam; leer, wenn das Team sie einträgt.
  exportId String?
  export   Export? @relation(fields: [exportId], references: [id], onDelete: SetNull)

  gastId String?
  gast   Gast?   @relation(fields: [gastId], references: [id], onDelete: SetNull)

  // Gesetzt, wenn jemand aus dem Team die Freigabe stellvertretend einträgt —
  // etwa weil der Kunde am Telefon zugestimmt hat.
  nutzerId String?
  nutzer   Nutzer? @relation(fields: [nutzerId], references: [id], onDelete: SetNull)

  autorName  String
  notiz      String?
  erstelltAm DateTime @default(now())

  // Je Stufe genau eine Freigabe pro Post.
  @@unique([postId, stufe])
  @@index([exportId])
  @@map("freigabe")
}

enum KommentarStatus {
  OFFEN
  ERLEDIGT
}

model Kommentar {
  id       String  @id @default(cuid())
  postId   String?
  post     Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  exportId String?
  export   Export? @relation(fields: [exportId], references: [id], onDelete: SetNull)

  // Welcher Abschnitt gemeint ist: "caption", "medium", "szene:3", "allgemein".
  abschnitt String @default("allgemein")

  autorName  String
  autorEmail String?
  gastId     String?
  gast       Gast?   @relation(fields: [gastId], references: [id], onDelete: SetNull)
  nutzerId   String?
  nutzer     Nutzer? @relation(fields: [nutzerId], references: [id], onDelete: SetNull)

  text   String
  /// `#intern` im Text: nur fürs Haus, der Kunde sieht den Kommentar nie.
  /// Beim Schreiben abgeleitet, damit die Abfrage filtern kann.
  intern Boolean         @default(false)
  status KommentarStatus @default(OFFEN)
  // Gesetzt, sobald jemand den Text nachträglich ändert. `aktualisiertAm`
  // taugt dafür nicht — das springt auch beim Erledigen.
  bearbeitetAm DateTime?

  antwortAufId String?
  antwortAuf   Kommentar?  @relation("Antworten", fields: [antwortAufId], references: [id], onDelete: Cascade)
  antworten    Kommentar[] @relation("Antworten")

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([postId])
  @@index([exportId])
  @@map("kommentar")
}

// ------------------------------------------------------- Benachrichtigungen

enum BenachrichtigungArt {
  KOMMENTAR
  FREIGABE
  EINLADUNG
  /** Etwas am Werkzeug selbst braucht Aufmerksamkeit, etwa eine abgelaufene Sitzung. */
  WARTUNG
  /** Ein Beitrag ist nicht rausgegangen. */
  VEROEFFENTLICHUNG
}

/**
 * Meldungen für die Glocke in der Kopfzeile. Bewusst eigenständig neben Mail
 * und Push: Wer beides abgeschaltet hat, soll trotzdem sehen, was passiert
 * ist, sobald er die Oberfläche öffnet.
 */
model Benachrichtigung {
  id       String              @id @default(cuid())
  nutzerId String
  nutzer   Nutzer              @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
  art      BenachrichtigungArt

  titel String
  text  String
  url   String

  kundeId String?
  postId  String?

  gelesenAm  DateTime?
  erstelltAm DateTime  @default(now())

  @@index([nutzerId, gelesenAm])
  @@map("benachrichtigung")
}

model PushAbo {
  id       String  @id @default(cuid())
  nutzerId String?
  nutzer   Nutzer? @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
  gastId   String?
  gast     Gast?   @relation(fields: [gastId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  erstelltAm DateTime @default(now())

  @@index([nutzerId])
  @@index([gastId])
  @@map("push_abo")
}

// ----------------------------------------------------------- Veröffentlichen

/**
 * Wohin ein Beitrag geht. Gebaut sind **Facebook und Instagram**; LinkedIn
 * und YouTube stehen schon hier, damit sie später ohne Migration danebenpassen
 * und `Veroeffentlichung` von Anfang an je Plattform zählt.
 */
enum Plattform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  YOUTUBE
}

/**
 * Woher ein Zugang stammt. Gebaut ist `SYSTEMNUTZER` — ein Token aus dem
 * Business Manager, das nicht abläuft und an keinem Menschen hängt. `PERSON`
 * steht daneben für den Fall, dass ein Kunde keine Partnerfreigabe erteilt:
 * Beide Wege münden in dieselben Seiten-Tokens, der Veröffentlichungscode
 * unterscheidet sie nie.
 */
enum ZugangsArt {
  SYSTEMNUTZER
  PERSON
}

/**
 * Ein Zugang, an dem mehrere Kunden hängen.
 *
 * Bewusst **kein** Feld an den Einstellungen und **kein** Token je Kunde: Ein
 * Systemnutzer bedient alle Kunden, deren Assets ihm zugewiesen sind. Stirbt
 * er, muss die Meldung sagen können, *welche* Kunden betroffen sind — das geht
 * nur, wenn die Kunden auf ihn zeigen. Dieselbe Form trägt später LinkedIn
 * (ein Zugang, viele Kunden) und YouTube (ein Zugang je Kanal).
 */
model PlattformZugang {
  id          String     @id @default(cuid())
  plattform   Plattform
  art         ZugangsArt @default(SYSTEMNUTZER)
  /** Menschenlesbar, steht in Fehlermeldungen: „Systemnutzer Preroll". */
  bezeichnung String

  /** Systemnutzer- bzw. Nutzer-Token. Verlässt den Server nie. */
  token      String
  /** Nur bei `PERSON` gesetzt — ein Systemnutzer-Token läuft nicht ab. */
  gueltigBis DateTime?

  geprueftAm DateTime?
  /** Leer heißt: Die letzte Prüfung lief durch. */
  fehler     String?
  /**
   * Damit die Meldung an die Administration je Ausfall nur einmal rausgeht.
   * Ein toter Zugang lässt sonst jeden fälligen Beitrag scheitern — und jeder
   * davon schriebe eine Mail über dieselbe Ursache.
   */
  gemeldetAm DateTime?

  /**
   * Nur bei LinkedIn gesetzt: Ein Mitgliedstoken läuft ab, und die Erneuerung
   * braucht das Auffrischungstoken. Meta-Systemnutzer kennen beides nicht.
   */
  auffrischToken String?

  kunden       Kunde[]
  linkedInFuer Kunde[] @relation("LinkedInZugang")

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@map("plattform_zugang")
}

/**
 * Wie weit eine Veröffentlichung ist.
 *
 * `UEBERGEBEN` heißt: Die Plattform hat den Termin und schaltet selbst frei —
 * Preroll ist fertig. Für Facebook und Instagram wird das **nicht** benutzt
 * (siehe `veroeffentlichung.ts`); es steht für YouTube bereit, wo das Video
 * lange vor dem Termin hochgeladen und mit `publishAt` scharfgestellt wird.
 */
enum VeroeffentlichungStand {
  GEPLANT
  LAEUFT
  UEBERGEBEN
  ERFOLGT
  FEHLGESCHLAGEN
}

model Veroeffentlichung {
  id        String                 @id @default(cuid())
  postId    String
  post      Post                   @relation(fields: [postId], references: [id], onDelete: Cascade)
  plattform Plattform
  stand     VeroeffentlichungStand @default(GEPLANT)

  /**
   * Kopie von `Post.postenAm`. Steht hier, damit der Lauf nicht bei jedem
   * Takt über die Posts joinen muss — und damit nachvollziehbar bleibt, für
   * wann ein bereits erledigter Beitrag einmal geplant war.
   */
  geplantFuer DateTime

  versuche Int     @default(0)
  meldung  String?
  /** Kennung des Beitrags auf der Plattform — für Rückfragen und Nachsehen. */
  externeId String?

  uebergebenAm DateTime?
  erledigtAm   DateTime?
  /** Wann über diesen Fehlschlag benachrichtigt wurde — je Fehlschlag einmal. */
  gemeldetAm   DateTime?

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  // Ein Beitrag geht je Plattform genau einmal raus. Die Doppelpost-Sperre
  // steht damit im Schema und nicht bloß im Code.
  @@unique([postId, plattform])
  @@index([stand, geplantFuer])
  @@map("veroeffentlichung")
}

// ------------------------------------------------------------- Einstellungen

enum MailTransport {
  SMTP
  MICROSOFT365
  GOOGLE
  DEAKTIVIERT
}

// Singleton — genau eine Zeile mit id = "singleton".
model Einstellungen {
  id String @id @default("singleton")

  workspaceName String @default("Preroll")
  logoUrl       String?
  akzentfarbe   String @default("#b00900")

  // Anmeldung
  lokalerLoginErlaubt Boolean @default(true)
  m365LoginErlaubt    Boolean @default(false)
  m365TenantId        String?
  m365ClientId        String?
  m365ClientSecret    String?
  // Eigene Mail-Domänen, kommagetrennt. Adressen daraus gehen beim Anmelden
  // direkt zu Microsoft; wer dort zum ersten Mal ankommt, bekommt ein Konto.
  // Leer heißt: keine Selbstregistrierung.
  m365Domaenen        String?

  // awork — vorerst nur die Verbindung. Was Preroll dorthin schreibt (Aufgaben,
  // Kommentare), ist noch nicht entschieden; die Anbindung steht schon, damit
  // der Schlüssel nicht später nachgereicht werden muss.
  // Instagram verlangt für viele Reels eine angemeldete Sitzung — ohne
  // Cookies antwortet es mit einer leeren Medienantwort, egal von welcher
  // Adresse. Inhalt einer cookies.txt im Netscape-Format.
  instagramCookies   String?
  instagramCookiesAm DateTime?
  instagramGeprueftAm DateTime?
  /** Reel, an dem die Sitzung geprüft wird — auch täglich im Hintergrund. */
  instagramTestUrl    String?
  /** Damit die Meldung an die Administration nur einmal je Ablauf rausgeht. */
  instagramGemeldetAm DateTime?
  /** Leer heißt: Die letzte Prüfung lief durch. */
  instagramFehler    String?

  // Kennzahlen über die Instagram-Sitzung holen. Bewusst getrennt vom
  // Reel-Download eingeschaltet: Es ist dieselbe Sitzung, und wer sie nur
  // für Videos hinterlegt hat, soll sie nicht ungefragt zusätzlich belasten.
  kennzahlenAktiv Boolean   @default(false)
  kennzahlenLaufAm DateTime?

  aworkAktiv     Boolean @default(false)
  aworkApiKey    String?
  aworkGeprueftAm DateTime?

  /**
   * Hauptschalter fürs Veröffentlichen. Steht neben dem Schalter je Kunde,
   * weil es einen Ort geben muss, an dem sich alles auf einmal anhalten
   * lässt — ohne bei zwanzig Kunden einzeln zu klicken.
   */
  veroeffentlichenAktiv Boolean   @default(false)
  /** Wann der Zeitplaner zuletzt gelaufen ist — für die Einstellungsseite. */
  veroeffentlichenLaufAm DateTime?

  // Mailversand — ein aktiver Transport, drei mögliche Wege.
  mailTransport MailTransport @default(DEAKTIVIERT)
  mailVonName   String?
  mailVonAdresse String?

  smtpHost     String?
  smtpPort     Int?
  smtpSicher   Boolean @default(true)
  smtpBenutzer String?
  smtpPasswort String?

  // Microsoft 365: Graph sendMail per Client-Credentials.
  msTenantId     String?
  msClientId     String?
  msClientSecret String?
  msPostfach     String?

  // Google: Gmail API per OAuth2-Refresh-Token.
  googleClientId     String?
  googleClientSecret String?
  googleRefreshToken String?
  googleAbsender     String?

  // Web-Push
  vapidPublicKey  String?
  vapidPrivateKey String?

  // Agenturanschrift für den Kontakt-Fuß der Export-Seite. Steht hier und
  // nicht am Konto, weil sie für alle dieselbe ist.
  agenturName    String?
  agenturAdresse String?
  agenturWebsite String?

  /**
   * Die LinkedIn-App. Anders als bei Meta lässt sich kein Token von Hand
   * hinterlegen: Ein Token für eine Firmenseite entsteht nur über den
   * Autorisierungsablauf, und der braucht die App-Daten.
   *
   * Zum Posten auf Firmenseiten verlangt LinkedIn die Community Management
   * API, und die gibt es nur nach einer Freigabe. Bis dahin bleiben die Felder
   * leer und der Abschnitt sagt das.
   */
  linkedinClientId     String?
  linkedinClientSecret String?

  // Klappe-Anbindung für finale Reels. Der Token entsteht über die
  // Gerätekopplung und wird als Bearer-Token mitgeschickt.
  klappeBasisUrl    String?
  klappeApiKey      String?
  klappeGekoppeltAm DateTime?
  klappeKonto       String?

  /**
   * Kurzer Weg zu den Videodaten, falls Klappe auf derselben Maschine läuft.
   *
   * Der Grund ist gemessen: Über die öffentliche Adresse verließ eine
   * 115-MB-Fassung den Rechner, lief durch Cloudflare und kam zurück — 131
   * Sekunden. Über die lokale Adresse dieselbe Fassung in 1,1 Sekunden. Im
   * ZIP-Abruf schrieb der Server in dieser Zeit kein Byte an den Browser, und
   * der Proxy davor legte die Verbindung still: Der Download „hing bei X MB"
   * und lief in eine Zeitüberschreitung.
   *
   * Gilt nur fürs Abholen von Medien. Die Kopplung und die Links, die jemand
   * anklickt, brauchen weiterhin die öffentliche Adresse. Leer heißt: alles
   * über `klappeBasisUrl`.
   */
  klappeMedienUrl   String?

  // Was beim Konzipieren eines Reels automatisch in Klappe entsteht.
  klappeVideoAnlegen   Boolean @default(true)
  klappeNamenNachziehen Boolean @default(true)
  klappeNamensschema   String  @default("{datum} {titel}")

  // Welche Fassungen Preroll übernimmt.
  klappeNurEndfassung   Boolean @default(false)
  klappeInterneZeigen   Boolean @default(false)
  klappeAutoAktualisieren Boolean @default(true)

  // Filtert die Videoauswahl im Editor zusätzlich zum Kundenprojekt.
  klappeNameEnthaelt String?

  aktualisiertAm DateTime @updatedAt

  @@map("einstellungen")
}
