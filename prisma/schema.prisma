// Preroll — Planung und Kundenfreigabe von Social-Media-Konzepten.
// Ein Workspace pro Container (kein Multi-Tenant), analog zu Klappe.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// Die Verbindungs-URL steht seit Prisma 7 in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Team & Auth

/**
 * Alle Rollen dürfen alles lesen und bearbeiten — sie unterscheiden sich in
 * den Rechten der Verwaltung und darin, wer worüber benachrichtigt wird.
 */
enum Rolle {
  /** Zusätzlich Einstellungen und Benutzerverwaltung. */
  ADMIN
  /** Bekommt Benachrichtigungen von allen Kunden. */
  PROJEKTMANAGER
  /** Bekommt Benachrichtigungen der betreuten Kunden und eigener Exporte. */
  DESIGNER
  /** Wie Designer, aber nicht als Ansprechpartner wählbar. */
  EDITOR
}

model Nutzer {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  initialen    String  @db.VarChar(4)
  passwortHash String?
  // Gesetzt, wenn das Konto über Microsoft Entra ID kommt.
  oidcSubjekt  String? @unique
  rolle        Rolle   @default(EDITOR)
  aktiv        Boolean @default(true)

  // Erscheinen im Kontakt-Fuß der Export-Seite, wenn dieses Konto dort als
  // Ansprechpartner steht. Die Agenturanschrift steht in den Einstellungen.
  position String?
  telefon  String?
  fotoId   String?
  foto     Medium? @relation("NutzerFoto", fields: [fotoId], references: [id], onDelete: SetNull)

  mailBenachrichtigungen Boolean @default(true)
  pushBenachrichtigungen Boolean @default(true)

  sessions       NutzerSession[]
  pushAbos       PushAbo[]
  verantwortlich Post[]          @relation("Verantwortlich")
  hochgeladen    Medium[]
  kommentare     Kommentar[]
  einladungen    ExportGast[]    @relation("Einladungen")
  freigaben      Freigabe[]
  benachrichtigungen Benachrichtigung[]
  hauptAnsprechpartnerVon Kunde[]  @relation("Hauptansprechpartner")
  betreut                 KundeBetreuer[]
  favoriten               KundeFavorit[]
  zusatzAnsprechpartnerVon Export[] @relation("ZusatzAnsprechpartner")

  erstelltAm     DateTime  @default(now())
  aktualisiertAm DateTime  @updatedAt
  zuletztAktivAm DateTime?

  @@map("nutzer")
}

/**
 * Angehefteter Kunde — je Nutzer, nicht je Team. Wer drei Kunden betreut,
 * will genau die in der Seitenleiste, nicht alle zwanzig.
 */
model KundeFavorit {
  id       String @id @default(cuid())
  nutzerId String
  nutzer   Nutzer @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
  kundeId  String
  kunde    Kunde  @relation(fields: [kundeId], references: [id], onDelete: Cascade)

  erstelltAm DateTime @default(now())

  @@unique([nutzerId, kundeId])
  @@index([kundeId])
  @@map("kunde_favorit")
}

model NutzerSession {
  id         String   @id @default(cuid())
  nutzerId   String
  nutzer     Nutzer   @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  laeuftAbAm DateTime
  erstelltAm DateTime @default(now())

  @@index([nutzerId])
  @@map("nutzer_session")
}

// Gäste sind Kundenkontakte, die sich passwortlos per Mail-Code anmelden.
model Gast {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  zuletztAktivAm DateTime?
  erstelltAm    DateTime  @default(now())

  mailBenachrichtigungen Boolean @default(true)
  pushBenachrichtigungen Boolean @default(false)

  sessions     GastSession[]
  pushAbos     PushAbo[]
  kommentare   Kommentar[]
  freigaben    Freigabe[]
  beteiligungen ExportGast[]

  @@map("gast")
}

// Verbindet Gast und Export. Entsteht durch Einladung aus dem Backend oder
// beim ersten Anmelden über einen Link — trägt die Gast-Übersicht „meine Freigaben".
model ExportGast {
  id       String @id @default(cuid())
  exportId String
  export   Export @relation(fields: [exportId], references: [id], onDelete: Cascade)
  gastId   String
  gast     Gast   @relation(fields: [gastId], references: [id], onDelete: Cascade)

  eingeladenAm       DateTime  @default(now())
  eingeladenVonId    String?
  eingeladenVon      Nutzer?   @relation("Einladungen", fields: [eingeladenVonId], references: [id], onDelete: SetNull)
  zuletztGeoeffnetAm DateTime?

  @@unique([exportId, gastId])
  @@index([gastId])
  @@map("export_gast")
}

model GastSession {
  id         String   @id @default(cuid())
  gastId     String
  gast       Gast     @relation(fields: [gastId], references: [id], onDelete: Cascade)
  exportId   String?
  export     Export?  @relation(fields: [exportId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  laeuftAbAm DateTime
  erstelltAm DateTime @default(now())

  @@index([gastId])
  @@map("gast_session")
}

// Sechsstelliger Anmeldecode per E-Mail — für Gäste, optional auch fürs Team.
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  exportId   String?
  versuche   Int       @default(0)
  eingelöstAm DateTime?
  laeuftAbAm DateTime
  erstelltAm DateTime  @default(now())

  @@index([email])
  @@map("login_code")
}

// ------------------------------------------------------------------- Stammdaten

model Kunde {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  handle     String? // Instagram-Handle ohne @
  logoId     String?
  logo       Medium? @relation("KundeLogo", fields: [logoId], references: [id], onDelete: SetNull)
  notiz      String?
  archiviert Boolean @default(false)

  // Profil-Kennzahlen. Aktuell manuell gepflegt; das Modell trägt bereits
  // alles, was die Graph API (Business Discovery) später liefern würde.
  follower       Int?
  gefolgt        Int?
  beitraege      Int?
  bio            String?
  website        String?
  kennzahlenAm   DateTime?
  kennzahlenTyp  KennzahlenQuelle @default(MANUELL)

  // Vorbelegung für neue Posts, wenn beim Anlegen kein Termin gesetzt wird.
  standardUhrzeit String @default("10:00")
  /**
   * Bei eigenen Kanälen gibt es niemanden, der freigeben müsste. Dann fällt
   * der Freigabeschritt weg — Posts wandern direkt von Konzept auf Final.
   */
  freigabenNoetig Boolean @default(true)

  // Verbindet den Kunden mit seinem Projekt in Klappe. Ohne diese Zuordnung
  // zeigt die Videoauswahl nichts an — sonst stünden dort alle Videos aller
  // Kunden, und das wird auf Dauer unübersichtlich.
  klappeProjektId   String?
  klappeProjektName String?
  // Das Gegenstück in awork. Was Preroll damit tut, ist noch offen — die
  // Zuordnung steht schon, damit sie nicht später nachgetragen werden muss.
  aworkProjektId    String?
  aworkProjektName  String?

  // Der Hauptansprechpartner steht auf jeder Export-Seite dieses Kunden und
  // bekommt jede Rückmeldung — auch wenn für einen Export zusätzlich jemand
  // anderes hinterlegt ist.
  hauptAnsprechpartnerId String?
  hauptAnsprechpartner   Nutzer? @relation("Hauptansprechpartner", fields: [hauptAnsprechpartnerId], references: [id], onDelete: SetNull)

  betreuer  KundeBetreuer[]
  favoriten KundeFavorit[]
  posts     Post[]
  medien          Medium[]
  exporte         Export[]
  customFelder    CustomFeldDefinition[]
  kennzahlen      KennzahlVerlauf[]

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@map("kunde")
}

enum KennzahlenQuelle {
  MANUELL
  GRAPH_API
}

// Tageswerte der Profil-Kennzahlen — ergibt nebenbei die Follower-Kurve.
model KennzahlVerlauf {
  id        String           @id @default(cuid())
  kundeId   String
  kunde     Kunde            @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  datum     DateTime         @db.Date
  follower  Int?
  gefolgt   Int?
  beitraege Int?
  quelle    KennzahlenQuelle @default(MANUELL)

  @@unique([kundeId, datum])
  @@map("kennzahl_verlauf")
}

/**
 * Wer einen Kunden betreut. Designer bekommen darüber ihre
 * Benachrichtigungen; Projektmanager hören ohnehin bei allen Kunden mit.
 */
model KundeBetreuer {
  id       String @id @default(cuid())
  kundeId  String
  kunde    Kunde  @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  nutzerId String
  nutzer   Nutzer @relation(fields: [nutzerId], references: [id], onDelete: Cascade)

  erstelltAm DateTime @default(now())

  @@unique([kundeId, nutzerId])
  @@index([nutzerId])
  @@map("kunde_betreuer")
}

// ---------------------------------------------------------------------- Medien

model Medium {
  id        String  @id @default(cuid())
  kundeId   String?
  kunde     Kunde?  @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  dateiname String
  // Pfad relativ zum Upload-Verzeichnis, nie an den Browser durchgereicht.
  pfad      String
  mimeTyp   String
  groesse   Int
  breite    Int
  hoehe     Int
  // Vorschau im Raster; bei 9:16-Medien der mittige 4:5-Ausschnitt.
  thumbPfad String?

  // Gesetzt, wenn dieses Medium beim Auftrennen eines Gesamtbildes entstand.
  quelleId String?
  quelle   Medium?  @relation("Auftrennung", fields: [quelleId], references: [id], onDelete: SetNull)
  abschnitte Medium[] @relation("Auftrennung")

  hochgeladenVonId String?
  hochgeladenVon   Nutzer? @relation(fields: [hochgeladenVonId], references: [id], onDelete: SetNull)

  postMedien       PostMedium[]
  kundeLogo        Kunde[]           @relation("KundeLogo")
  nutzerFoto       Nutzer[]          @relation("NutzerFoto")

  erstelltAm DateTime @default(now())

  @@index([kundeId])
  @@map("medium")
}

// ----------------------------------------------------------------------- Posts

enum PostTyp {
  REEL
  KARUSSELL
  BEITRAG
}

enum PostStatus {
  KONZEPT
  VORSCHAU
  FINAL
}

model Post {
  id      String     @id @default(cuid())
  kundeId String
  kunde   Kunde      @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  typ     PostTyp
  status  PostStatus @default(KONZEPT)

  // Datum und Uhrzeit der Veröffentlichung — trägt die ZIP-Dateinamen. Leer
  // heißt: noch ungeplant. Solche Posts stehen im Kalender in einer eigenen
  // Spalte und lassen sich von dort auf einen Tag ziehen.
  postenAm DateTime?

  titel            String
  kurzbeschreibung String?
  caption          String  @default("")

  // Freie Eckdaten aus dem Editor.
  laenge String?
  ziel   String?
  stil   String?

  verantwortlichId String?
  verantwortlich   Nutzer? @relation("Verantwortlich", fields: [verantwortlichId], references: [id], onDelete: SetNull)

  // Reel: Szenenplan ist optional. Ohne ihn tritt das Freitextfeld an seine Stelle.
  szenenplanAktiv Boolean @default(true)
  inhalte         String?

  // Video von einem Link. Das Ergebnis hängt als MEDIUM am Post — derselbe
  // Platz, den auch ein Upload füllt; einen eigenen Referenzvideo-Platz gibt
  // es nicht. Der Download läuft im Hintergrund weiter, auch wenn der Dialog
  // zugeht — deshalb steht sein Stand in der Datenbank und nicht im Speicher.
  videoDownloadUrl         String?
  videoDownloadStand       Ladestand?
  videoDownloadFortschritt Int        @default(0)
  videoDownloadMeldung     String?

  // Finales Reel aus Klappe. Das Video entsteht beim Anlegen des Posts
  // automatisch mit, damit beim Upload kein Name mehr getippt werden muss.
  klappeVideoId       String?
  klappeVideoName     String?
  klappeVideoUrl      String?
  klappeVersionId     String?
  klappeVersionNummer Int?
  klappeStandAm       DateTime?

  szenen       Szene[]
  medien       PostMedium[]
  customWerte  CustomFeldWert[]
  kommentare   Kommentar[]
  freigaben    Freigabe[]

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([kundeId, postenAm])
  @@map("post")
}

enum MediumRolle {
  MEDIUM // Beitragsbild oder Reel-Video
  SLIDE // Karussell-Slide
  THUMBNAIL // Reel-Thumbnail (9:16)
}

model PostMedium {
  id       String      @id @default(cuid())
  postId   String
  post     Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediumId String
  medium   Medium      @relation(fields: [mediumId], references: [id], onDelete: Cascade)
  rolle    MediumRolle @default(MEDIUM)
  position Int         @default(0)

  @@unique([postId, rolle, position])
  @@index([mediumId])
  @@map("post_medium")
}

/** Wie weit ein Video-Download ist. Leer heißt: keiner gelaufen. */
enum Ladestand {
  LAEUFT
  FERTIG
  FEHLER
}

model Szene {
  id               String  @id @default(cuid())
  postId           String
  post             Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  position         Int
  abschnitt        String  @default("Szene") // Hook, Intro, Szene, Abbinder
  bildSzene        String?
  sprechertext     String?
  texteinblendung  String?

  @@unique([postId, position])
  @@map("szene")
}

enum CustomFeldTyp {
  TEXT
  DATUM
  JANEIN
}

// Eigene Felder werden pro Kunde definiert und je Post befüllt.
model CustomFeldDefinition {
  id       String        @id @default(cuid())
  kundeId  String
  kunde    Kunde         @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  name     String
  typ      CustomFeldTyp @default(TEXT)
  position Int           @default(0)

  werte CustomFeldWert[]

  @@unique([kundeId, name])
  @@map("custom_feld_definition")
}

model CustomFeldWert {
  id           String               @id @default(cuid())
  postId       String
  post         Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  definitionId String
  definition   CustomFeldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  wert         String?

  @@unique([postId, definitionId])
  @@map("custom_feld_wert")
}

// --------------------------------------------------------------------- Export

model Export {
  id      String @id @default(cuid())
  kundeId String
  kunde   Kunde  @relation(fields: [kundeId], references: [id], onDelete: Cascade)

  // Öffentlicher Token im Link /f/<token>.
  token String @unique
  titel String?

  zeitraumVon DateTime  @db.Date
  zeitraumBis DateTime  @db.Date
  gueltigBis  DateTime?

  // Zusätzlicher Ansprechpartner nur für diesen Link. Er erscheint neben dem
  // Hauptansprechpartner des Kunden und bekommt dessen Rückmeldungen mit —
  // ersetzt ihn also nicht.
  zusatzAnsprechpartnerId String?
  zusatzAnsprechpartner   Nutzer? @relation("ZusatzAnsprechpartner", fields: [zusatzAnsprechpartnerId], references: [id], onDelete: SetNull)

  kommentareErlaubt Boolean @default(true)
  // Darf der Kunde auf dieser Seite freigeben? Freigaben hängen am einzelnen
  // Post, nicht am Link.
  freigabenErlaubt  Boolean @default(true)
  konzepteMitzeigen Boolean @default(false)

  aufrufe          Int       @default(0)
  zuletztGeoeffnet DateTime?

  kommentare   Kommentar[]
  freigaben    Freigabe[]
  gastSessions GastSession[]
  gaeste       ExportGast[]

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([kundeId])
  @@map("export")
}

/**
 * Der Kunde gibt zweimal frei: einmal das Konzept, nach dem Dreh die Vorschau.
 * Welche Stufe ansteht, ergibt sich aus dem Status des Posts.
 */
enum Freigabestufe {
  KONZEPT
  VORSCHAU
}

model Freigabe {
  id     String        @id @default(cuid())
  postId String
  post   Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  stufe  Freigabestufe

  // Über welchen Link die Freigabe kam; leer, wenn das Team sie einträgt.
  exportId String?
  export   Export? @relation(fields: [exportId], references: [id], onDelete: SetNull)

  gastId String?
  gast   Gast?   @relation(fields: [gastId], references: [id], onDelete: SetNull)

  // Gesetzt, wenn jemand aus dem Team die Freigabe stellvertretend einträgt —
  // etwa weil der Kunde am Telefon zugestimmt hat.
  nutzerId String?
  nutzer   Nutzer? @relation(fields: [nutzerId], references: [id], onDelete: SetNull)

  autorName  String
  notiz      String?
  erstelltAm DateTime @default(now())

  // Je Stufe genau eine Freigabe pro Post.
  @@unique([postId, stufe])
  @@index([exportId])
  @@map("freigabe")
}

enum KommentarStatus {
  OFFEN
  ERLEDIGT
}

model Kommentar {
  id       String  @id @default(cuid())
  postId   String?
  post     Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  exportId String?
  export   Export? @relation(fields: [exportId], references: [id], onDelete: SetNull)

  // Welcher Abschnitt gemeint ist: "caption", "medium", "szene:3", "allgemein".
  abschnitt String @default("allgemein")

  autorName  String
  autorEmail String?
  gastId     String?
  gast       Gast?   @relation(fields: [gastId], references: [id], onDelete: SetNull)
  nutzerId   String?
  nutzer     Nutzer? @relation(fields: [nutzerId], references: [id], onDelete: SetNull)

  text   String
  status KommentarStatus @default(OFFEN)

  antwortAufId String?
  antwortAuf   Kommentar?  @relation("Antworten", fields: [antwortAufId], references: [id], onDelete: Cascade)
  antworten    Kommentar[] @relation("Antworten")

  erstelltAm     DateTime @default(now())
  aktualisiertAm DateTime @updatedAt

  @@index([postId])
  @@index([exportId])
  @@map("kommentar")
}

// ------------------------------------------------------- Benachrichtigungen

enum BenachrichtigungArt {
  KOMMENTAR
  FREIGABE
  EINLADUNG
  /** Etwas am Werkzeug selbst braucht Aufmerksamkeit, etwa eine abgelaufene Sitzung. */
  WARTUNG
}

/**
 * Meldungen für die Glocke in der Kopfzeile. Bewusst eigenständig neben Mail
 * und Push: Wer beides abgeschaltet hat, soll trotzdem sehen, was passiert
 * ist, sobald er die Oberfläche öffnet.
 */
model Benachrichtigung {
  id       String              @id @default(cuid())
  nutzerId String
  nutzer   Nutzer              @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
  art      BenachrichtigungArt

  titel String
  text  String
  url   String

  kundeId String?
  postId  String?

  gelesenAm  DateTime?
  erstelltAm DateTime  @default(now())

  @@index([nutzerId, gelesenAm])
  @@map("benachrichtigung")
}

model PushAbo {
  id       String  @id @default(cuid())
  nutzerId String?
  nutzer   Nutzer? @relation(fields: [nutzerId], references: [id], onDelete: Cascade)
  gastId   String?
  gast     Gast?   @relation(fields: [gastId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  erstelltAm DateTime @default(now())

  @@index([nutzerId])
  @@index([gastId])
  @@map("push_abo")
}

// ------------------------------------------------------------- Einstellungen

enum MailTransport {
  SMTP
  MICROSOFT365
  GOOGLE
  DEAKTIVIERT
}

// Singleton — genau eine Zeile mit id = "singleton".
model Einstellungen {
  id String @id @default("singleton")

  workspaceName String @default("Preroll")
  logoUrl       String?
  akzentfarbe   String @default("#b00900")

  // Anmeldung
  lokalerLoginErlaubt Boolean @default(true)
  m365LoginErlaubt    Boolean @default(false)
  m365TenantId        String?
  m365ClientId        String?
  m365ClientSecret    String?
  // Eigene Mail-Domänen, kommagetrennt. Adressen daraus gehen beim Anmelden
  // direkt zu Microsoft; wer dort zum ersten Mal ankommt, bekommt ein Konto.
  // Leer heißt: keine Selbstregistrierung.
  m365Domaenen        String?

  // awork — vorerst nur die Verbindung. Was Preroll dorthin schreibt (Aufgaben,
  // Kommentare), ist noch nicht entschieden; die Anbindung steht schon, damit
  // der Schlüssel nicht später nachgereicht werden muss.
  // Instagram verlangt für viele Reels eine angemeldete Sitzung — ohne
  // Cookies antwortet es mit einer leeren Medienantwort, egal von welcher
  // Adresse. Inhalt einer cookies.txt im Netscape-Format.
  instagramCookies   String?
  instagramCookiesAm DateTime?
  instagramGeprueftAm DateTime?
  /** Reel, an dem die Sitzung geprüft wird — auch täglich im Hintergrund. */
  instagramTestUrl    String?
  /** Damit die Meldung an die Administration nur einmal je Ablauf rausgeht. */
  instagramGemeldetAm DateTime?
  /** Leer heißt: Die letzte Prüfung lief durch. */
  instagramFehler    String?

  aworkAktiv     Boolean @default(false)
  aworkApiKey    String?
  aworkGeprueftAm DateTime?

  // Mailversand — ein aktiver Transport, drei mögliche Wege.
  mailTransport MailTransport @default(DEAKTIVIERT)
  mailVonName   String?
  mailVonAdresse String?

  smtpHost     String?
  smtpPort     Int?
  smtpSicher   Boolean @default(true)
  smtpBenutzer String?
  smtpPasswort String?

  // Microsoft 365: Graph sendMail per Client-Credentials.
  msTenantId     String?
  msClientId     String?
  msClientSecret String?
  msPostfach     String?

  // Google: Gmail API per OAuth2-Refresh-Token.
  googleClientId     String?
  googleClientSecret String?
  googleRefreshToken String?
  googleAbsender     String?

  // Web-Push
  vapidPublicKey  String?
  vapidPrivateKey String?

  // Agenturanschrift für den Kontakt-Fuß der Export-Seite. Steht hier und
  // nicht am Konto, weil sie für alle dieselbe ist.
  agenturName    String?
  agenturAdresse String?
  agenturWebsite String?

  // Klappe-Anbindung für finale Reels. Der Token entsteht über die
  // Gerätekopplung und wird als Bearer-Token mitgeschickt.
  klappeBasisUrl    String?
  klappeApiKey      String?
  klappeGekoppeltAm DateTime?
  klappeKonto       String?

  // Was beim Konzipieren eines Reels automatisch in Klappe entsteht.
  klappeVideoAnlegen   Boolean @default(true)
  klappeNamenNachziehen Boolean @default(true)
  klappeNamensschema   String  @default("{datum} {titel}")

  // Welche Fassungen Preroll übernimmt.
  klappeNurEndfassung   Boolean @default(false)
  klappeInterneZeigen   Boolean @default(false)
  klappeAutoAktualisieren Boolean @default(true)

  // Filtert die Videoauswahl im Editor zusätzlich zum Kundenprojekt.
  klappeNameEnthaelt String?

  aktualisiertAm DateTime @updatedAt

  @@map("einstellungen")
}
